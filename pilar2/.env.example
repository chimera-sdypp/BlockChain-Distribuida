# Copiar a .env (no se versiona) y cargar con: set -a; . ./.env; set +a
# Todas son opcionales: estos son los valores por defecto.
PUERTO=8080
LOG_NIVEL=INFO
LOGS_DIR=logs

RABBIT_HOST=localhost
RABBIT_PUERTO=5672
RABBIT_USUARIO=guest
RABBIT_CLAVE=guest
RABBIT_VHOST=/
RABBIT_PREFETCH=1

REDIS_HOST=localhost
REDIS_PUERTO=6379
REDIS_CLAVE=
# Lista host:puerto,host:puerto. Vacía: se conecta directo a REDIS_HOST.
REDIS_SENTINELS=
REDIS_MASTER=mymaster
