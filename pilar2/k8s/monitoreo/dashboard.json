{
  "uid": "blockchain-dashboard",
  "title": "Blockchain distribuida",
  "tags": [
    "blockchain",
    "BC-37"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
